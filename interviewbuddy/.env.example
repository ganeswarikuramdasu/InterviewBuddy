# ============================================================
# InterviewBuddy — Environment Configuration
# Copy this file to .env (or export these as real environment
# variables) and fill in real values. NEVER commit a real .env file.
# ============================================================

# ---- Database (Supabase - hosted PostgreSQL) ----
# Get these from your Supabase project: Project Settings > Database >
# "Connection String" (PSQL / JDBC). DB_HOST is the hostname ONLY (no
# protocol/port). Supabase requires TLS, so DB_SSLMODE=require is the default.
DB_HOST=db.YOUR-PROJECT-REF.supabase.co   # e.g. db.abcdefghijk.supabase.co
DB_PORT=5432
DB_NAME=postgres                            # usually "postgres" unless you created another DB
DB_USERNAME=postgres                        # usually the superuser role name
DB_PASSWORD=                                 # your Supabase database password
DB_SSLMODE=require                           # "require" for Supabase, "disable" for local Postgres

# ---- JWT ----
# Use a long, random string in production (32+ characters).
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-this-super-secret-key-in-production-minimum-32-chars
JWT_EXPIRATION_MS=86400000

# ---- CORS ----
# With the docker stack, the SPA and API share the nginx origin, so this is
# usually the nginx URL. Comma-separate multiple origins if needed.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# ---- AI (Google Gemini) ----
# Leave blank to run the AI Interview module in graceful fallback mode
# (heuristic scoring, clearly labelled as non-AI in the UI).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---- Code Execution ----
# Leave blank to run the Coding module in dev-mode (non-sandboxed heuristic
# evaluation). Point at a Judge0-compatible REST API for real, sandboxed code
# execution. IMPORTANT: shipping the heuristic mode in production lets users
# submit arbitrary strings with no code exec, but a real Judge0 instance is
# strongly recommended.
CODE_EXECUTION_SERVICE_URL=

# ---- Demo data ----
# Set to false in production to disable automatic creation of demo accounts.
SEED_DEMO_USERS=false
DEMO_PASSWORD=Passw0rd!

# ---- Email verification (Brevo transactional email) ----
# Email is sent through the Brevo (formerly Sendinblue) Transactional Email
# API. Sign up at https://www.brevo.com, verify a sender email or domain
# (Settings > Senders & IPs > Senders), then create an API key under
# Settings > API Keys. Copy it into BREVO_API_KEY. NEVER commit a real key.
# Set MAIL_ENABLED=true to actually send.
MAIL_ENABLED=false
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
MAIL_FROM=noreply@interviewbuddy.com     # must be a verified sender in Brevo
MAIL_FROM_NAME=InterviewBuddy
# Public URL of the SPA - used to build the verification link users click.
APP_FRONTEND_URL=http://localhost:8081

# ---- Server ----
SERVER_PORT=8080

# ---- Docker deployment ----
# Host port that nginx (frontend) binds to. SPA lives at http://localhost:8081
FRONTEND_PORT=8081
